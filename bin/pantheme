#!/usr/bin/env python3
"""pantheme: theme switcher for elementary OS, inspired by Omarchy.

Downloads the palettes and wallpapers of Omarchy's themes (MIT; the wallpapers
belong to their authors) and applies them to Ghostty, Starship, btop, Zed, the
wallpaper and Pantheon's accent color and light/dark mode. Installed as
~/.local/bin/pantheme, with `tema` (its former name) as an alias. Messages are
in Spanish when the locale is Spanish. Run `pantheme --help` for the usage.
"""
import colorsys
import json
import os
import re
import subprocess
import sys
import time
import tomllib
import urllib.error
import urllib.request
from pathlib import Path

HOME = Path.home()
# Data paths keep the command's former name, so existing installs keep working
DATA = HOME / ".local/share/tema"
STATE = HOME / ".config/tema"
API = "https://api.github.com/repos/omacom/omarchy/contents/themes"
ANIMATED_UNIT = "pantheme-animated.service"


# ---------------------------------------------------------------- messages
def language():
    """'es' when the locale for messages is Spanish (LC_ALL > LC_MESSAGES > LANG)."""
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var)
        if value:
            return "es" if value.startswith("es") else "en"
    return "en"


LANG = language()

MSG = {
    "help": (
        """pantheme: theme switcher for elementary OS, inspired by Omarchy.

Usage:
  pantheme                  show the current theme and the list of themes
  pantheme <theme>          apply a theme (downloaded the first time)
  pantheme wallpaper        next wallpaper of the current theme
  pantheme animated on|off  turn the animated wallpaper on or off
                            (for themes that have one: matrix, tokyo-night)
  pantheme help             this help

`tema` is an alias of `pantheme`, and the Spanish subcommands still work:
fondo (wallpaper), animado (animated), ayuda (help).

It applies the palettes and wallpapers of Omarchy's themes
(github.com/omacom/omarchy, MIT; the wallpapers belong to their authors) to
Ghostty, Starship, btop, Zed, the wallpaper and Pantheon's accent color and
light/dark mode.

Your own themes: a folder ~/.local/share/tema/<name>/ with colors.toml
(Omarchy's format, plus an optional [starship] table for the prompt palette)
and, optionally, an executable `animado` (the animated wallpaper). A folder
with the name of one of Omarchy's themes and no colors.toml adds its files
(e.g. an `animado`) to that theme.

Environment:
  PANTHEME_WALLPAPERS  wallpaper folder (default ~/Pictures/Wallpapers, or the
                       XDG pictures folder + /Wallpapers if that doesn't exist)
  GITHUB_TOKEN         optional GitHub token, to avoid the API's rate limit""",
        """pantheme: cambiador de temas para elementary OS, inspirado en Omarchy.

Uso:
  pantheme                  muestra el tema actual y la lista de temas
  pantheme <tema>           aplica un tema (lo descarga la primera vez)
  pantheme fondo            pasa al siguiente fondo del tema actual
  pantheme animado on|off   activa o desactiva el fondo animado
                            (para los temas que tienen uno: matrix, tokyo-night)
  pantheme ayuda            esta ayuda

`tema` es un alias de `pantheme`, y también valen los subcomandos en inglés:
wallpaper (fondo), animated (animado), help (ayuda).

Aplica las paletas y fondos de los temas de Omarchy
(github.com/omacom/omarchy, MIT; los fondos son de sus autores) a Ghostty,
Starship, btop, Zed, el fondo de pantalla y el color de acento y el modo
claro/oscuro de Pantheon.

Temas propios: una carpeta ~/.local/share/tema/<nombre>/ con colors.toml
(formato de Omarchy, con una tabla [starship] opcional para la paleta del
prompt) y, si se quiere, un ejecutable `animado` (el fondo animado). Una
carpeta con el nombre de un tema de Omarchy y sin colors.toml le agrega sus
archivos (por ejemplo un `animado`) a ese tema.

Variables de entorno:
  PANTHEME_WALLPAPERS  carpeta de fondos (por defecto ~/Pictures/Wallpapers, o
                       la carpeta de imágenes de XDG + /Wallpapers si aquella
                       no existe)
  GITHUB_TOKEN         token opcional de GitHub, para evitar el límite de la API"""),
    "current": ("Current theme: {theme}\n\nAvailable:", "Tema actual: {theme}\n\nDisponibles:"),
    "hint": ("\nUsage: pantheme <theme>  |  pantheme wallpaper  |  pantheme help",
             "\nUso: pantheme <tema>  |  pantheme fondo  |  pantheme ayuda"),
    "unknown": ("Unknown theme '{name}'. Run `pantheme` to see the list.",
                "No existe el tema '{name}'. Escribí `pantheme` para ver la lista."),
    "downloading_palette": ("Downloading the {name} palette…", "Descargando la paleta de {name}…"),
    "downloading_walls": ("Downloading the {name} wallpapers…", "Descargando los fondos de {name}…"),
    "no_colors": ("Theme {name} has no colors.toml", "El tema {name} no tiene colors.toml"),
    "download_failed": (
        "Could not download {name} from GitHub ({error}).\n"
        "If it's GitHub's API rate limit (60 requests per hour without a token),\n"
        "wait a while or set GITHUB_TOKEN.",
        "No se pudo descargar {name} de GitHub ({error}).\n"
        "Si es el límite de pedidos de la API de GitHub (60 por hora sin token),\n"
        "esperá un rato o definí GITHUB_TOKEN."),
    "applied": ("Theme {name} applied ({mode}, accent {accent}, wallpaper {wall}).",
                "Tema {name} aplicado ({mode}, acento {accent}, fondo {wall})."),
    "reloaded": ("Ghostty reloaded; btop picks up the theme when you open it again.",
                 "Ghostty se recargó; btop toma el tema al volver a abrirlo."),
    "dark": ("dark", "oscuro"),
    "light": ("light", "claro"),
    "no_walls": ("The current theme has no wallpapers.", "El tema actual no tiene fondos."),
    "animated_off": ("Animated wallpaper turned off.", "Fondo animado desactivado."),
    "animated_on": ("Animated wallpaper turned on (if the current theme has one).",
                    "Fondo animado activado (si el tema actual tiene uno)."),
    "animated_usage": ("Usage: pantheme animated on|off", "Uso: pantheme animado on|off"),
}


def t(key, **kw):
    en, es = MSG[key]
    return (es if LANG == "es" else en).format(**kw)


# Subcommands, with the Spanish names of `tema` as aliases
WALLPAPER = ("wallpaper", "fondo")
ANIMATED = ("animated", "animado")
HELP = ("-h", "--help", "help", "ayuda")


def wallpapers_dir():
    custom = os.environ.get("PANTHEME_WALLPAPERS") or os.environ.get("TEMA_WALLPAPERS")
    if custom:
        return Path(custom).expanduser()
    default = HOME / "Pictures/Wallpapers"
    if default.is_dir():
        return default
    try:
        pics = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True, text=True).stdout.strip()
    except FileNotFoundError:
        pics = ""
    # When it isn't configured, xdg-user-dir prints $HOME
    return Path(pics) / "Wallpapers" if pics and Path(pics) != HOME else default


WALLS = wallpapers_dir()

# Zed theme for each Omarchy theme (the ones that have an equivalent)
ZED = {
    "tokyo-night": "Tokyo Night",
    "catppuccin": "Catppuccin Mocha",
    "catppuccin-latte": "Catppuccin Latte",
    "rose-pine": "Rosé Pine Dawn",
    "everforest": "Everforest Dark Medium (regular)",
    "kanagawa": "Kanagawa Wave",
    "nord": "Nord Dark",
    "gruvbox": "Gruvbox Dark",
    "matrix": "Matrix",
}
ZED_FALLBACK = {"dark": "One Dark", "light": "One Light"}

# elementary's accent colors and their hue (degrees)
ACCENTS = {
    "blueberry": 212, "strawberry": 357, "orange": 24, "banana": 43,
    "lime": 103, "mint": 170, "grape": 268, "bubblegum": 335,
}
ACCENT_OVERRIDE = {"tokyo-night": "grape"}


# ---------------------------------------------------------------- helpers
def fetch(url):
    headers = {"User-Agent": "pantheme"}
    if url.startswith("https://api.github.com/") and os.environ.get("GITHUB_TOKEN"):
        headers["Authorization"] = f"Bearer {os.environ['GITHUB_TOKEN']}"
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=30) as r:
        return r.read()


def run(*cmd):
    """Runs a command if it exists (outside the desktop there may be no gsettings)."""
    try:
        return subprocess.run(cmd, check=False, capture_output=True, text=True)
    except FileNotFoundError:
        return None


def gset(schema, key, value):
    run("gsettings", "set", schema, key, value)


def current():
    try:
        return (STATE / "actual").read_text().strip()
    except OSError:
        return None


def local_themes():
    return sorted(p.name for p in DATA.iterdir() if (p / "colors.toml").exists()) if DATA.exists() else []


def remote_themes():
    cache = DATA / "temas.json"
    try:
        if time.time() - cache.stat().st_mtime < 86400:
            return json.loads(cache.read_text())
    except OSError:
        pass
    try:
        names = [e["name"] for e in json.loads(fetch(API)) if e["type"] == "dir"]
        DATA.mkdir(parents=True, exist_ok=True)
        cache.write_text(json.dumps(names))
        return names
    except Exception:
        return []


def available():
    remote = remote_themes()
    return remote + [n for n in local_themes() if n not in remote]


# ---------------------------------------------------------------- download
def download(name):
    tdir = DATA / name
    colors = tdir / "colors.toml"
    wdir = WALLS / name
    if not colors.exists():
        print(t("downloading_palette", name=name))
        entries = {e["name"]: e for e in json.loads(fetch(f"{API}/{name}"))}
        if "colors.toml" not in entries:
            sys.exit(t("no_colors", name=name))
        tdir.mkdir(parents=True, exist_ok=True)
        colors.write_bytes(fetch(entries["colors.toml"]["download_url"]))
    if not wdir.exists() or not any(wdir.glob("*.jpg")):
        print(t("downloading_walls", name=name))
        from PIL import Image
        wdir.mkdir(parents=True, exist_ok=True)
        try:
            bgs = json.loads(fetch(f"{API}/{name}/backgrounds"))
        except Exception:
            bgs = []
        for e in bgs:
            if not re.search(r"\.(jpe?g|png|webp)$", e["name"], re.I) or e["name"].startswith("omarchy."):
                continue
            src = wdir / e["name"]
            src.write_bytes(fetch(e["download_url"]))
            dst = src.with_suffix(".jpg")
            if src != dst:
                Image.open(src).convert("RGB").save(dst, quality=95)
                src.unlink()
    c = tomllib.loads(colors.read_text())
    c.setdefault("orange", c.get("bright_yellow", c["yellow"]))
    return c


# ---------------------------------------------------------------- apply
def ghostty(c):
    tdir = HOME / ".config/ghostty/themes"
    tdir.mkdir(parents=True, exist_ok=True)
    pal = [
        c["dark_background"], c["red"], c["green"], c["yellow"],
        c["blue"], c["magenta"], c["cyan"], c["foreground"],
        c["muted"], c.get("bright_red", c["red"]), c.get("bright_green", c["green"]),
        c.get("bright_yellow", c["yellow"]), c.get("bright_blue", c["blue"]),
        c.get("bright_magenta", c["magenta"]), c.get("bright_cyan", c["cyan"]),
        c["bright_foreground"],
    ]
    lines = [f"palette = {i}={v}" for i, v in enumerate(pal)] + [
        f"background = {c['background']}",
        f"foreground = {c['foreground']}",
        f"cursor-color = {c['bright_foreground']}",
        f"selection-background = {c['selection']}",
        f"selection-foreground = {c['bright_foreground']}",
    ]
    (tdir / "tema").write_text("# Generated by pantheme\n" + "\n".join(lines) + "\n")
    cfg = HOME / ".config/ghostty/config"
    if cfg.exists():
        txt = cfg.read_text()
        txt = re.sub(r"(?m)^theme\s*=.*$", "theme = tema", txt)
        txt = re.sub(r"(?m)^window-theme\s*=.*$", "window-theme = auto", txt)
        cfg.write_text(txt)
    # Reload open windows, only if the process handles SIGUSR2
    pgrep = run("pgrep", "-x", "ghostty")
    for pid in (pgrep.stdout.split() if pgrep else []):
        try:
            caught = int(re.search(r"SigCgt:\s*(\w+)", Path(f"/proc/{pid}/status").read_text()).group(1), 16)
            if caught & (1 << 11):
                os.kill(int(pid), 12)
        except (OSError, AttributeError, ValueError):
            pass


def starship(c):
    cfg = HOME / ".config/starship.toml"
    if not cfg.exists():
        return
    pal = {
        "seg1": c["light_foreground"], "seg2": c["accent"], "seg3": c["muted"],
        "seg4": c["lighter_background"], "seg5": c["dark_background"],
        "txt_dark": c["darker_background"], "txt_light": c["bright_foreground"],
        "txt_muted": c["foreground"],
    }
    pal.update(c.get("starship", {}))
    block = "[palettes.tema]\n" + "".join(f'{k} = "{v}"\n' for k, v in pal.items())
    txt = cfg.read_text()
    txt = re.sub(r"(?m)^\[palettes\.tema\]\n(?:[^\[\n].*\n?)*", block, txt)
    cfg.write_text(txt)


def btop(c):
    tdir = HOME / ".config/btop/themes"
    tdir.mkdir(parents=True, exist_ok=True)
    theme = {
        "main_bg": c["background"], "main_fg": c["foreground"], "title": c["bright_foreground"],
        "hi_fg": c["accent"], "selected_bg": c["selection"], "selected_fg": c["bright_foreground"],
        "inactive_fg": c["muted"], "graph_text": c["dark_foreground"], "meter_bg": c["muted"],
        "proc_misc": c["cyan"], "cpu_box": c["accent"], "mem_box": c["green"],
        "net_box": c["magenta"], "proc_box": c["blue"], "div_line": c["muted"],
        "temp_start": c["green"], "temp_mid": c["yellow"], "temp_end": c["red"],
        "cpu_start": c["cyan"], "cpu_mid": c["blue"], "cpu_end": c["magenta"],
        "free_start": c["green"], "free_mid": c["green"], "free_end": c["cyan"],
        "cached_start": c["blue"], "cached_mid": c["blue"], "cached_end": c["cyan"],
        "available_start": c["yellow"], "available_mid": c["yellow"], "available_end": c["orange"],
        "used_start": c["orange"], "used_mid": c["red"], "used_end": c["red"],
        "download_start": c["blue"], "download_mid": c["cyan"], "download_end": c["accent"],
        "upload_start": c["magenta"], "upload_mid": c["red"], "upload_end": c["orange"],
        "process_start": c["cyan"], "process_mid": c["blue"], "process_end": c["magenta"],
    }
    (tdir / "tema.theme").write_text("".join(f'theme[{k}]="{v}"\n' for k, v in theme.items()))
    cfg = HOME / ".config/btop/btop.conf"
    txt = cfg.read_text() if cfg.exists() else ""
    if re.search(r"(?m)^color_theme\s*=", txt):
        txt = re.sub(r"(?m)^color_theme\s*=.*$", 'color_theme = "tema"', txt)
    else:
        txt = 'color_theme = "tema"\n' + txt
    cfg.write_text(txt)


def zed(name, mode):
    cfg = HOME / ".config/zed/settings.json"
    if not cfg.exists():
        return
    theme = ZED.get(name, ZED_FALLBACK[mode])
    txt = cfg.read_text()
    new = re.sub(rf'("theme"\s*:\s*\{{[^}}]*?"{mode}"\s*:\s*)"[^"]*"', rf'\g<1>"{theme}"', txt, count=1)
    if new != txt:
        cfg.write_text(new)


def pantheon(name, c, mode):
    gset("org.gnome.desktop.interface", "color-scheme", "prefer-light" if mode == "light" else "prefer-dark")
    accent = ACCENT_OVERRIDE.get(name)
    if not accent:
        r, g, b = (int(c["accent"][i:i + 2], 16) / 255 for i in (1, 3, 5))
        h, _, s = colorsys.rgb_to_hls(r, g, b)
        if s < 0.2:
            accent = "slate"
        else:
            deg = h * 360
            accent = min(ACCENTS, key=lambda a: min(abs(ACCENTS[a] - deg), 360 - abs(ACCENTS[a] - deg)))
    gset("org.gnome.desktop.interface", "gtk-theme", f"io.elementary.stylesheet.{accent}")
    return accent


def wallpaper(name, step=0):
    walls = sorted((WALLS / name).glob("*.jpg"))
    if not walls:
        return None
    idx_file = STATE / "fondo"
    try:
        idx = int(idx_file.read_text()) if step else 0
    except (OSError, ValueError):
        idx = 0
    idx = (idx + step) % len(walls)
    STATE.mkdir(parents=True, exist_ok=True)
    idx_file.write_text(str(idx))
    uri = walls[idx].as_uri()
    gset("org.gnome.desktop.background", "picture-uri", uri)
    gset("org.gnome.desktop.background", "picture-uri-dark", uri)
    return walls[idx].name


def animated(action=None):
    """Without an action: runs the current theme's animated wallpaper (the service does this)."""
    off = STATE / "animado-off"
    if action == "off":
        STATE.mkdir(parents=True, exist_ok=True)
        off.touch()
        run("systemctl", "--user", "stop", ANIMATED_UNIT)
        print(t("animated_off"))
        return
    if action == "on":
        off.unlink(missing_ok=True)
        run("systemctl", "--user", "restart", ANIMATED_UNIT)
        print(t("animated_on"))
        return
    if action is not None:
        sys.exit(t("animated_usage"))
    script = DATA / (current() or "") / "animado"
    if off.exists() or not os.access(script, os.X_OK):
        return
    os.execv(script, [str(script)])


def apply(name):
    try:
        c = download(name)
    except (urllib.error.URLError, OSError) as e:
        sys.exit(t("download_failed", name=name, error=e))
    mode = c.get("mode", "dark")
    ghostty(c)
    starship(c)
    btop(c)
    zed(name, mode)
    accent = pantheon(name, c, mode)
    wall = wallpaper(name)
    STATE.mkdir(parents=True, exist_ok=True)
    (STATE / "actual").write_text(name)
    # The service starts the new theme's animated wallpaper, or exits if it has none
    run("systemctl", "--user", "restart", ANIMATED_UNIT)
    print(t("applied", name=name, mode=t(mode) if mode in ("dark", "light") else mode,
            accent=accent, wall=wall or "—"))
    print(t("reloaded"))


# ---------------------------------------------------------------- main
def main():
    args = sys.argv[1:]
    if not args:
        cur = current()
        print(t("current", theme=cur or "—"))
        for n in available():
            mark = "●" if n == cur else " "
            print(f"  {mark} {n}")
        print(t("hint"))
        return
    if args[0] in HELP:
        print(t("help"))
        return
    if args[0] in ANIMATED:
        animated(args[1] if len(args) > 1 else None)
        return
    if args[0] in WALLPAPER:
        cur = current() or "tokyo-night"
        print(wallpaper(cur, step=1) or t("no_walls"))
        return
    name = args[0]
    names = available()
    if names and name not in names:
        sys.exit(t("unknown", name=name))
    apply(name)


if __name__ == "__main__":
    main()
