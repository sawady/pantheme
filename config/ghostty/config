# Ghostty: the colors come from themes/tema, which `pantheme` generates
# The original, if there was one, is kept in ~/.local/state/pantheme/backup

# Theme
theme = tema

# Font
font-family = JetBrainsMono Nerd Font
font-size = 12
font-feature = -calt

# Window
window-padding-x = 14
window-padding-y = 14
window-padding-balance = true
window-decoration = auto
window-theme = auto
background-opacity = 0.95
confirm-close-surface = true
resize-overlay = never

# Cursor
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# Misc
mouse-hide-while-typing = true
copy-on-select = clipboard
