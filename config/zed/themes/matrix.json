          {
            "cursor": "#c8ffd2",
            "selection": "#00ff4133",
            "background": "#00ff41"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#008f11",
            "font_style": "italic"
          },
          "comment.doc": {
            "color": "#008f11",
            "font_style": "italic"
          },
          "keyword": {
            "color": "#c8ffd2",
            "font_weight": 700
          },
          "string": {
            "color": "#9cff57"
          },
          "string.escape": {
            "color": "#c6ff00"
          },
          "number": {
            "color": "#c6ff00"
          },
          "boolean": {
            "color": "#c6ff00"
          },
          "constant": {
            "color": "#c6ff00"
          },
          "function": {
            "color": "#3dffcf"
          },
          "function.method": {
            "color": "#3dffcf"
          },
          "type": {
            "color": "#7dff9a"
          },
          "variable": {
            "color": "#00ff41"
          },
          "property": {
            "color": "#5cff7f"
          },
          "attribute": {
            "color": "#00d1a0"
          },
          "tag": {
            "color": "#c8ffd2"
          },
          "operator": {
            "color": "#5cff7f"
          },
          "punctuation": {
            "color": "#008f11"
          },
          "punctuation.bracket": {
            "color": "#5cff7f"
          },
