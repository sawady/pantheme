{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Matrix",
  "author": "tema",
  "themes": [
    {
      "name": "Matrix",
      "appearance": "dark",
      "style": {
        "background": "#0d0208",
        "surface.background": "#050104",
        "elevated_surface.background": "#0f1f12",
        "border": "#123d1a",
        "border.variant": "#123d1a",
        "border.focused": "#008f11",
        "border.selected": "#00ff41",
        "text": "#00ff41",
        "text.muted": "#008f11",
        "text.placeholder": "#1f5f2a",
        "text.accent": "#c8ffd2",
        "icon": "#00ff41",
        "icon.muted": "#008f11",
        "icon.accent": "#c8ffd2",
        "element.background": "#0f1f12",
        "element.hover": "#0a2a10",
        "element.active": "#003b00",
        "element.selected": "#003b00",
        "ghost_element.hover": "#0a2a10",
        "ghost_element.selected": "#003b00",
