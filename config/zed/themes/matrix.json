            "color": "#c8ffd2",
            "font_weight": 700
          },
          "link_text": {
            "color": "#3dffcf"
          },
          "link_uri": {
            "color": "#00d1a0"
          },
          "emphasis": {
            "color": "#5cff7f",
            "font_style": "italic"
          },
          "emphasis.strong": {
            "color": "#c8ffd2",
            "font_weight": 700
          }
