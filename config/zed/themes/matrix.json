        "terminal.ansi.blue": "#00b36b",
        "terminal.ansi.magenta": "#7dff9a",
        "terminal.ansi.cyan": "#00d1a0",
        "terminal.ansi.white": "#00ff41",
        "terminal.ansi.bright_black": "#1f5f2a",
        "terminal.ansi.bright_red": "#ff7070",
        "terminal.ansi.bright_green": "#66ff8a",
        "terminal.ansi.bright_yellow": "#e1ff66",
        "terminal.ansi.bright_blue": "#33d68f",
        "terminal.ansi.bright_magenta": "#a8ffbb",
        "terminal.ansi.bright_cyan": "#3dffcf",
        "terminal.ansi.bright_white": "#c8ffd2",
        "error": "#ff4747",
        "warning": "#c6ff00",
        "success": "#00ff41",
        "info": "#00d1a0",
